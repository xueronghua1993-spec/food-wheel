:host{display:block}.weather-bar{display:flex;flex-direction:column;align-items:flex-end;gap:2rpx;padding:8rpx 12rpx;border-radius:20rpx;background:#edf2e5;color:#285744;font-size:22rpx;line-height:1.4}.weather-city{display:block;text-align:right;white-space:normal;overflow-wrap:anywhere}.weather-detail{display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:6rpx;max-width:100%}.temperature{font-weight:650;white-space:nowrap}.weather-icon{font-size:24rpx}.weather-description{white-space:normal;overflow-wrap:anywhere;text-align:right}.temperature,.weather-icon{flex:none}
