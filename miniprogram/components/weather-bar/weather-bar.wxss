:host{display:block;width:100%}.weather-bar{display:flex;align-items:center;gap:12rpx;background:#edf2e5;border-radius:24rpx;padding:8rpx 12rpx;min-height:88rpx;box-sizing:border-box}button{border:0;margin:0;box-sizing:border-box;font-family:inherit;line-height:1.5}button::after{border:0}.weather-main{flex:1;min-width:0;width:0;min-height:72rpx;background:transparent;text-align:left;padding:8rpx 12rpx;font-size:24rpx;color:#285744}.weather-line{display:flex;gap:12rpx;align-items:center;flex-wrap:wrap}.temperature{font-weight:600}.range{font-size:22rpx;color:#657467}.weather-note{font-size:20rpx;color:#748074;line-height:1.4}.city-button{flex:none;min-width:104rpx;min-height:80rpx;padding:12rpx;background:#fffdf7;border-radius:18rpx;font-size:24rpx;color:#285744}button[disabled]{opacity:.6}
