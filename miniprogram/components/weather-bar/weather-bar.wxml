<view wx:if="{{weather}}" class="weather-bar" aria-label="天气数据来自 Open-Meteo"><text wx:if="{{weather.cityLabel}}" class="weather-city">{{weather.cityLabel}}</text><view class="weather-detail"><text class="weather-icon">{{weather.icon}}</text><text class="temperature">{{weather.temperature}}°</text><text class="weather-description">{{weather.description}}</text></view></view>
