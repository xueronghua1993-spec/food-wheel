<view class="weather-bar"><button class="weather-main" bindtap="refresh" disabled="{{loading}}" aria-label="查看或刷新天气"><view wx:if="{{weather}}" class="weather-line"><text>{{weather.icon}} {{weather.name}}</text><text class="temperature">{{weather.temperature}}° {{weather.description}}</text><text class="range">{{weather.low}}～{{weather.high}}°</text></view><text wx:else>{{loading ? '正在查看天气…' : error || '☀ 点击查看今日天气'}}</text><view wx:if="{{weather}}" class="weather-note">{{loading ? '正在更新…' : error || weather.source + ' · 点击刷新'}} · Open-Meteo</view></button><button class="city-button" bindtap="chooseCity">换城市</button></view>
