-break:break-all;font-size:28rpx}.done{text-decoration:line-through;color:#8e9c83}.delete{color:#8e9c83;font-size:22rpx;flex-shrink:0;padding:10rpx}.export-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;pointer-events:none}.export-preview{width:100%;height:52vh;margin-top:16rpx}.todos-card{min-height:420rpx}
