<view class="screen calendar-screen">
 <view class="row calendar-heading"><view><view class="eyebrow">日常小决定</view><view class="title">{{readOnly ? '往日日历' : '每日一页'}}</view></view><picker mode="date" value="{{selected}}" start="{{firstDate}}" end="{{today}}" bindchange="pickDate" disabled="{{saving}}"><view class="date-picker" role="button" aria-label="选择日历日期">{{selected}} ⌄</view></picker></view>
 <view class="tabs"><button class="{{view === 'paper' ? 'active' : ''}}" data-view="paper" bindtap="switchView">一页日历</button><button class="{{view === 'todos' ? 'active' : ''}}" data-view="todos" bindtap="switchView">{{readOnly ? '当日待办' : '今日待办'}} · {{done}}/{{todos.length}}</button></view>
 <view wx:if="{{view === 'paper' && entry}}" class="paper"><view class="paper-top row"><text>日常小决定</text><text class="paper-dot">●</text><text>每日一页</text></view><image class="calendar-photo" src="{{photo}}" mode="aspectFill" binderror="photoError" aria-label="{{entry.imageAlt}}"/><view wx:if="{{photoLoading}}" class="photo-note">正在准备当天照片…</view><view wx:if="{{photoError}}" class="photo-note" bindtap="retryPhoto">{{photoError}} 点击重试</view><view class="paper-content"><scroll-view scroll-y class="reading-scroll"><view class="kind">{{entry.type === 'story' ? '一个小故事' : entry.type === 'excerpt' ? '读一段经典' : '每日一句'}}</view><view class="quote {{entry.type === 'story' ? 'story-quote' : ''}}">{{entry.text}}</view><view class="source">{{entry.type === 'story' ? '根据' : ''}}{{entry.author}} {{entry.work}}{{entry.type === 'story' ? '转述' : ''}}</view><button wx:if="{{entry.fullText}}" class="link small" bindtap="toggleFull">{{fullOpen ? '收起全文 ↑' : '读完整故事 ↓'}}</button><view wx:if="{{fullOpen}}" class="full-story">{{entry.fullText}}</view></scroll-view><view class="date-row"><view class="day-number">{{info.day >= 10 ? info.day : '0' + info.day}}</view><view class="date-meta"><view class="date-title">{{info.year}}年{{info.month}}月{{info.day}}日</view><view>{{info.weekday}}</view><view wx:if="{{info.lunar}}">农历{{info.lunar}}</view></view></view><view class="remaining">今年还剩 {{info.remainingDays}} 天</view></view></view>
 <scroll-view wx:if="{{view === 'todos'}}" scroll-y class="card todos-card"><view class="todos-body"><view class="row"><text class="section-title">{{readOnly ? '当日待办' : '今日待办'}}</text><text class="muted">已完成 {{done}}/{{todos.length}}</text></view><view class="note">{{readOnly ? '往日待办仅供回看。' : '写下一件小事，让今天更有方向。'}}</view><view wx:if="{{!readOnly}}" class="row todo-form"><input class="input" value="{{todoInput}}" bindinput="inputTodo" bindconfirm="addTodo" maxlength="100" placeholder="今天想做的一件小事" confirm-type="done"/><button class="primary small" bindtap="addTodo">添加</button></view><view wx:if="{{todoError}}" class="error">{{todoError}}</view><view wx:if="{{!todos.length}}" class="empty">{{readOnly ? '这天没有记录待办。' : '还没有待办，先写下一件小事吧。'}}</view><view wx:for="{{todos}}" wx:key="id" class="todo-row"><view class="todo-main" role="checkbox" aria-checked="{{item.done}}" aria-disabled="{{readOnly}}" data-id="{{item.id}}" bindtap="toggleTodo"><view class="check {{item.done ? 'checked' : ''}}">{{item.done ? '✓' : ''}}</view><text class="todo-text {{item.done ? 'done' : ''}}">{{item.text}}</text></view><button wx:if="{{!readOnly}}" class="link small delete" data-id="{{item.id}}" bindtap="removeTodo">删除</button></view><view class="note">{{status}}</view></view></scroll-view>
 <view class="row navigation"><button class="secondary small" bindtap="prev" disabled="{{selected === firstDate || saving}}">← 前一天</button><button class="link small" bindtap="goToday" disabled="{{selected === today || saving}}">回到今天</button><button class="secondary small" bindtap="next" disabled="{{selected >= today || saving}}">后一天 →</button></view>
 <view wx:if="{{view === 'paper'}}" class="row actions"><button class="primary" bindtap="saveImage" disabled="{{saving || photoLoading}}">{{saving ? '正在生成…' : '保存图片'}}</button><button class="secondary" open-type="share">分享给朋友</button></view><button wx:if="{{view === 'paper'}}" class="link timeline-share" bindtap="shareTimeline">分享到朋友圈</button><view wx:if="{{view === 'paper'}}" class="footer">一天一页，把日子过得认真一点。</view>
</view>
<canvas type="2d" id="export-canvas" class="export-canvas"/>
<view wx:if="{{previewPath}}" class="modal-backdrop"><view class="modal"><view class="row"><text class="section-title">日历图片已生成</text><button class="link small preview-close" bindtap="closePreview" disabled="{{saving}}">关闭</button></view><image class="export-preview" src="{{previewPath}}" mode="aspectFit" bindtap="previewImage" show-menu-by-longpress/><view class="note">点击查看大图，也可长按保存。</view><button class="primary" bindtap="saveAlbum" disabled="{{saving}}">{{saving ? '正在保存…' : '保存到手机相册'}}</button><button wx:if="{{albumDenied}}" class="link" bindtap="openSettings">打开设置，允许保存图片</button></view></view>
