.screen{padding:12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));max-width:920rpx;margin:0 auto}
.calendar-peek{display:flex;align-items:center;gap:20rpx;overflow:hidden;background:#fffdf7;border:1rpx solid #e8e8df;border-radius:36rpx;padding:20rpx;color:#244c3c}
.peek-photo{width:128rpx;height:148rpx;flex-shrink:0;border-radius:20rpx;background:#e8ecdf}
.peek-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}
.peek-date,.peek-more{font-size:24rpx;color:#657467;line-height:1.5}
.peek-quote{font-family:"Songti SC",SimSun,serif;font-size:32rpx;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tabs{margin:20rpx 0;background:#e7e9df;border-radius:32rpx;padding:10rpx;gap:0}
.tabs button{padding:18rpx 8rpx;border-radius:24rpx;color:#748074;font-weight:650;font-size:28rpx}
.tabs .active{background:#fff;color:#244c3c}
.wheel-card{margin:0;padding:24rpx 28rpx;background:#fffdf7;border-color:#e9e8de;border-radius:48rpx}
.section-title{font-size:26rpx;color:#345844}.edit-menu{font-size:24rpx;padding:12rpx 0;color:#637765}
.wheel-wrap{position:relative;width:520rpx;height:520rpx;margin:28rpx auto 16rpx}
.wheel{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:50%;box-shadow:0 12rpx 44rpx #37493812}
.pointer{position:absolute;top:-12rpx;left:50%;transform:translateX(-50%);border-left:20rpx solid transparent;border-right:20rpx solid transparent;border-top:44rpx solid #244f3d;z-index:2}
.hub{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:104rpx;height:104rpx;border:8rpx solid #fff;border-radius:50%;background:#244f3d;color:#fff;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:650}
.winner{margin:20rpx 0;padding:18rpx;border-radius:28rpx;background:#edf2e7;display:flex;flex-direction:column;text-align:center}
.winner-name{font-size:42rpx;font-weight:650;overflow-wrap:anywhere;color:#244f3d}
.spin{width:100%;margin-top:20rpx;font-size:30rpx;min-height:96rpx;background:#244f3d;border-radius:28rpx}
.draft-row{display:flex;gap:12rpx;margin:12rpx 0}.draft-row .input{flex:1}.remove{background:#edf2e5;font-size:34rpx;padding:12rpx 24rpx}.modal .row button{flex:1}.reset-menu{width:100%;margin-top:16rpx;font-size:24rpx}
@media(max-width:360px){.screen{padding-left:28rpx;padding-right:28rpx}.peek-photo{width:120rpx;height:136rpx}.peek-quote{font-size:30rpx}}
@media(max-height:640px){.wheel-wrap{width:440rpx;height:440rpx}.peek-photo{height:120rpx}.peek-quote{-webkit-line-clamp:1}}
