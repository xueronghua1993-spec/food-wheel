<view class="screen">
 <view class="row masthead"><view><text class="brand-mark">◉</text><text class="brand">日常小决定</text></view><button class="account-button" bindtap="openAccount" disabled="{{busy}}" aria-label="账号与同步">{{logged ? '已登录' : '账号'}}</button></view>
 <view class="weather-row" bindtap="toggleWeather"><text wx:if="{{weather}}">{{weather.icon}} {{weather.name}} · {{weather.temperature}}°C {{weather.description}}</text><text wx:else class="muted">{{weatherMessage}}</text><text class="muted">⌄</text></view>
 <view wx:if="{{weatherOpen}}" class="card weather-panel"><view wx:if="{{weather}}" class="note">{{weather.source}} · 当地 {{weather.date}} · {{weather.low}}～{{weather.high}}°C</view><view wx:if="{{weatherMessage}}" class="note">{{weatherMessage}}</view><view class="row"><input class="input" value="{{cityInput}}" bindinput="cityInput" placeholder="选择城市，如上海" confirm-type="search" bindconfirm="searchCity"/><button class="small" bindtap="searchCity">搜索</button></view><view class="note">{{cityMessage}}</view><button wx:for="{{cities}}" wx:key="label" data-index="{{index}}" class="link city-choice" bindtap="chooseCity">{{item.label}}</button><view class="row"><button class="link small" bindtap="autoWeather">自动估算城市</button><button class="link small" bindtap="retryWeather">刷新天气</button></view></view>
 <view class="hero"><view class="eyebrow">生活里的选择，轻一点</view><view class="title">{{mode === 'coffee' ? '今天喝什么咖啡？' : '今天吃什么？'}}</view><view class="muted">{{mode === 'coffee' ? '好好喝咖啡，把纠结留给转盘。' : '好好吃饭，把纠结留给转盘。'}}</view></view>
 <view class="tabs"><button class="{{mode === 'food' ? 'active' : ''}}" data-mode="food" bindtap="switchMode" disabled="{{busy}}">一餐好饭</button><button class="{{mode === 'coffee' ? 'active' : ''}}" data-mode="coffee" bindtap="switchMode" disabled="{{busy}}">一杯咖啡</button></view>
 <view class="card wheel-card"><view class="row"><text class="section-title">{{mode === 'coffee' ? '我的咖啡转盘' : '我的餐食转盘'}}</text><text class="muted">{{menu.length}} 个选项</text></view><view class="wheel-wrap"><view class="pointer"></view><canvas type="2d" id="wheel" class="wheel"/><view class="hub">{{mode === 'coffee' ? '喝' : '吃'}}</view><view wx:if="{{winner}}" class="winner"><text class="muted">{{mode === 'coffee' ? '今天就喝' : '今天就吃'}}</text><text class="winner-name">{{winner}}</text></view></view><view class="caption">{{busy ? '让转盘替你想一想…' : '每个选项，都有同样的机会'}}</view><button class="primary spin" bindtap="spin" disabled="{{busy}}">{{busy ? '正在选…' : winner ? (mode === 'coffee' ? '再选一杯 ↻' : '再选一餐 ↻') : (mode === 'coffee' ? '帮我选一杯 ↗' : '帮我选一餐 ↗')}}</button><view class="row tools"><button class="link small" bindtap="editMenu" disabled="{{busy}}">{{mode === 'coffee' ? '编辑咖啡 →' : '编辑菜单 →'}}</button><button class="link small" bindtap="resetMenu" disabled="{{busy}}">恢复默认</button></view><view wx:if="{{notice}}" class="error">{{notice}}</view></view>
 <view class="calendar-peek" bindtap="openCalendar"><image class="peek-photo" src="{{miniPhoto}}" mode="aspectFill" binderror="imageError"/><view class="peek-body"><view class="row"><text class="eyebrow">每日一页</text><text class="muted">{{miniDate}}</text></view><view class="peek-quote">{{miniText}}</view><view class="row"><text class="muted">今日待办 {{todoCount}}</text><text class="muted">打开日历 →</text></view></view></view>
 <view class="footer">{{status}}</view>
</view>
<view wx:if="{{editing}}" class="modal-backdrop"><view class="modal"><view class="row"><text class="section-title">{{mode === 'coffee' ? '喜欢的咖啡，都放进来' : '想吃的，都放进来'}}</text><text class="muted">{{draft.length}}/10</text></view><view class="note">保留 2～10 项，每项最多 8 个字，不重复。</view><scroll-view scroll-y class="modal-scroll"><view wx:for="{{draftRows}}" wx:key="id" class="draft-row"><input class="input" value="{{item.value}}" data-index="{{index}}" bindinput="draftInput" placeholder="例如：{{mode === 'coffee' ? '燕麦拿铁' : '盖浇饭'}}"/><button class="remove" data-index="{{index}}" bindtap="removeOption" aria-label="删除第{{index + 1}}项">×</button></view></scroll-view><view wx:if="{{editError}}" class="error">{{editError}}</view><button class="link" bindtap="addOption" disabled="{{draft.length >= 10}}">＋ 添加选项</button><view class="row"><button class="secondary" bindtap="cancelEdit">取消</button><button class="primary" bindtap="saveMenu">保存菜单</button></view></view></view>
