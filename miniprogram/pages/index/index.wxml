<view class="screen">
 <view class="calendar-peek" bindtap="openCalendar" role="button" aria-label="打开完整日历"><image class="peek-photo" src="{{miniPhoto}}" mode="aspectFill" binderror="imageError"/><view class="peek-body"><view class="peek-date">{{miniDate}}</view><view class="peek-quote">{{miniText}}</view><view class="peek-more">展开日历 · 待办 {{todoCount}} ↗</view></view></view>
 <view class="tabs"><button class="{{mode === 'food' ? 'active' : ''}}" data-mode="food" bindtap="switchMode" disabled="{{busy}}">吃什么</button><button class="{{mode === 'coffee' ? 'active' : ''}}" data-mode="coffee" bindtap="switchMode" disabled="{{busy}}">喝什么咖啡</button></view>
 <view class="card wheel-card"><view class="row"><text class="section-title">{{mode === 'coffee' ? '我的咖啡转盘' : '我的餐食转盘'}}</text><button class="link small edit-menu" bindtap="editMenu" disabled="{{busy}}">{{mode === 'coffee' ? '编辑咖啡 →' : '编辑菜单 →'}}</button></view><view class="wheel-wrap"><view class="pointer"></view><canvas type="2d" id="wheel" class="wheel"/><view class="hub">{{mode === 'coffee' ? '喝' : '吃'}}</view></view><view wx:if="{{winner}}" class="winner"><text class="muted">{{mode === 'coffee' ? '今天就喝' : '今天就吃'}}</text><text class="winner-name">{{winner}}</text></view><button class="primary spin" bindtap="spin" disabled="{{busy}}">{{busy ? '正在选…' : winner ? (mode === 'coffee' ? '再选一杯 ↻' : '再选一餐 ↻') : (mode === 'coffee' ? '帮我选一杯 ↗' : '帮我选一餐 ↗')}}</button><view wx:if="{{notice}}" class="error">{{notice}}</view></view>

</view>
<view wx:if="{{editing}}" class="modal-backdrop"><view class="modal"><view class="row"><text class="section-title">{{mode === 'coffee' ? '喜欢的咖啡，都放进来' : '想吃的，都放进来'}}</text><text class="muted">{{draft.length}}/10</text></view><view class="note">保留 2～10 项，每项最多 8 个字，不重复。</view><scroll-view scroll-y class="modal-scroll"><view wx:for="{{draftRows}}" wx:key="id" class="draft-row"><input class="input" value="{{item.value}}" data-index="{{index}}" bindinput="draftInput" placeholder="例如：{{mode === 'coffee' ? '燕麦拿铁' : '盖浇饭'}}"/><button class="remove" data-index="{{index}}" bindtap="removeOption" aria-label="删除第{{index + 1}}项">×</button></view></scroll-view><view wx:if="{{editError}}" class="error">{{editError}}</view><button class="link" bindtap="addOption" disabled="{{draft.length >= 10}}">＋ 添加选项</button><view class="row"><button class="secondary" bindtap="cancelEdit">取消</button><button class="primary" bindtap="saveMenu">保存菜单</button></view><button class="link reset-menu" bindtap="resetMenu">恢复默认菜单 ↺</button></view></view>
