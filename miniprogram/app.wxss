page{background:#fcfff6;color:#285744;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,button,textarea{box-sizing:border-box}button{margin:0;font-size:28rpx;line-height:1.5;border-radius:24rpx;padding:22rpx 28rpx;background:#edf2e5;color:#285744}button::after{border:0}button[disabled]{opacity:.5}.primary{background:#285744;color:#fcfff6;font-weight:600}.secondary{background:#edf2e5}.link{background:transparent;padding:12rpx;color:#62854e}.screen{padding:30rpx 34rpx calc(40rpx + env(safe-area-inset-bottom))}.muted{color:#7b896f;font-size:24rpx}.eyebrow{color:#62854e;font-size:22rpx;letter-spacing:4rpx}.title{font-size:50rpx;font-weight:650;line-height:1.3;margin:16rpx 0}.card{background:#fffef8;border:1rpx solid #dee6d5;border-radius:32rpx;padding:28rpx;box-shadow:0 12rpx 40rpx #28574408;margin:24rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:18rpx}.section-title{font-size:32rpx;font-weight:600}.tabs{display:flex;gap:10rpx;padding:6rpx;background:#edf2e5;border-radius:24rpx}.tabs button{flex:1;background:transparent;padding:16rpx}.tabs .active{background:#fffef8;box-shadow:0 4rpx 16rpx #28574410}.error{color:#985e40;font-size:24rpx;margin:16rpx 0;white-space:pre-wrap}.input{background:#fffef8;border:1rpx solid #d8e2ce;border-radius:18rpx;padding:20rpx;height:88rpx;width:100%}.empty{padding:32rpx 0;color:#7b896f;font-size:26rpx}.note{font-size:24rpx;color:#7b896f;margin:18rpx 0}.divider{height:1rpx;background:#dee6d5;margin:24rpx 0}.modal-backdrop{position:fixed;inset:0;background:#18352870;z-index:10;display:flex;align-items:center;justify-content:center;padding:30rpx}.modal{background:#fcfff6;border-radius:32rpx;padding:30rpx;width:100%;max-height:86vh}.modal-scroll{max-height:50vh}.small{font-size:24rpx;padding:14rpx 22rpx}.footer{text-align:center;font-size:22rpx;color:#7b896f;margin-top:36rpx}
